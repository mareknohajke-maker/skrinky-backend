{
  "info": {
    "name": "Aplikacia Skrinky API",
    "description": "Kompletná API kolekcia pre testovanie aplikácie skrinky",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "memberToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "lockerId",
      "value": "locker-1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('memberToken', response.token);",
                  "    pm.test('Registration successful', () => {",
                  "        pm.expect(response.token).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ján\",\n  \"lastName\": \"Novák\",\n  \"email\": \"jan.novak@test.sk\",\n  \"phone\": \"+421900123456\",\n  \"gender\": \"muž\",\n  \"password\": \"test123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login Member (Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('memberToken', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"jan.novak@test.sk\",\n  \"password\": \"test123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Member (Name)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"Ján Novák\",\n  \"password\": \"test123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Login Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('ownerToken', response.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"admin@skrinky.sk\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["users", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Lockers",
      "item": [
        {
          "name": "Get All Lockers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers",
              "host": ["{{baseUrl}}"],
              "path": ["lockers"]
            }
          }
        },
        {
          "name": "Reserve Locker (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/reserve",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "reserve"]
            }
          }
        },
        {
          "name": "Open Locker (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/open",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "open"]
            }
          }
        },
        {
          "name": "Close Locker (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "close"]
            }
          }
        },
        {
          "name": "Release Locker (Member)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/release",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "release"]
            }
          }
        },
        {
          "name": "Open Any Locker (Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/open",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "open"]
            }
          }
        },
        {
          "name": "Force Release (Owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/lockers/{{lockerId}}/release",
              "host": ["{{baseUrl}}"],
              "path": ["lockers", "{{lockerId}}", "release"]
            }
          }
        }
      ]
    },
    {
      "name": "History",
      "item": [
        {
          "name": "Get All History (Owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["history"]
            }
          }
        },
        {
          "name": "Get Locker History (Owner)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/history/locker/{{lockerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["history", "locker", "{{lockerId}}"]
            }
          }
        },
        {
          "name": "Get My History (Member)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{memberToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/history/me",
              "host": ["{{baseUrl}}"],
              "path": ["history", "me"]
            }
          }
        }
      ]
    }
  ]
}
